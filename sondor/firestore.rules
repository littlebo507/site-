rules_version='2';service cloud.firestore{match /databases/{database}/documents{function admin(){return request.auth!=null&&exists(/databases/$(database)/documents/admins/$(request.auth.uid));}match /orders/{id}{allow create:if true;allow read,update,delete:if admin();}match /admins/{uid}{allow read:if request.auth!=null&&request.auth.uid==uid;allow write:if false;}}}